# Copie como .env no servidor e preencha com os valores reais:
#   cp .env.example .env && nano .env

# Porta interna da aplicação (o Nginx aponta para ela)
PORT=3000

# Troque por uma chave aleatória forte antes de ir para produção
JWT_SECRET=troque-por-uma-chave-forte-e-unica

# Mercado Pago — token de PRODUÇÃO
MP_ACCESS_TOKEN=

# Webhook público (opcional): sem ele, o poller confirma os pagamentos automaticamente
# WEBHOOK_URL=https://seudominio.com/api/pay/webhook
